# このファイルは見本です。コピーして .env を作り、実際の値を入れてください。
# cp .env.example .env
# ※ .env は Git にコミットしないでください。

# Flaskのセッション署名キー（長いランダム文字列）
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ログイン用パスワード（8文字以上。推測されにくいものにする）
APP_PASSWORD=

# 保存先: sheets（Googleスプレッドシート）または memory（動作確認用）
STORAGE_BACKEND=sheets

# スプレッドシートのID（URLの /d/ と /edit の間の文字列）
SPREADSHEET_ID=your-spreadsheet-id

# シート名（存在しなければ自動作成）
WORKSHEET_NAME=todos

# サービスアカウント鍵JSONのパス（ローカル開発向け）
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# サーバーでファイルを置けない場合は、鍵JSONの中身を1行で設定（上とどちらか一方）
# GOOGLE_CREDENTIALS_JSON=

# Googleカレンダー連携（任意）。登録先カレンダーのID。空欄なら連携しない。
# カレンダーをサービスアカウントのメールアドレスに「予定の変更」権限で共有しておく。
GOOGLE_CALENDAR_ID=

# LINE通知（任意）。LINE Developers の Messaging API チャネルで発行する。
# チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# 通知を送る自分のユーザーID（チャネルの「基本設定」にある「あなたのユーザーID」、U から始まる）
LINE_USER_ID=
# 通知用URL（POST /tasks/notify-due）を呼ぶための秘密のトークン（32文字以上）
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_TOKEN=
# 通知メッセージに付けるアプリのURL（任意。例: https://example.onrender.com）
APP_BASE_URL=

# 期限判定に使うタイムゾーン
APP_TIMEZONE=Asia/Tokyo
